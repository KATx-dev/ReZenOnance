# ReZenOnance Nightly Configuration

# HTTP Server Settings
PORT=3000
HOST=0.0.0.0

# Provider Engine: "multi" (races Arcod & Monochrome concurrently)
QOBUZ_PROVIDER=multi
INSTABLE_BASE_URL=https://arcod.xyz
MONOCHROME_BASE_URL=https://tracks.monochrome.st

# Master Admin Key (Required for /admin panel)
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# Security Secret for Cryptographic HMAC ID Signing
QOBUZ_ID_SECRET=rezen-production-secret-replace-with-a-random-string

# Persistent 30-Day Community Cache (Recommended on Vercel Serverless: Upstash Redis / Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Supabase Persistent Store (requires supabase/migrations/20261126000000_community_cache.sql)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DISABLE_SUPABASE=false

# Request Timeouts
REQUEST_TIMEOUT_MS=10000
UPSTREAM_RETRIES=2
