# ReZenOnance Configuration

# HTTP Server Settings
PORT=3000
HOST=0.0.0.0

# Provider Engine: "multi" (races Heisenberg & Arcod concurrently)
QOBUZ_PROVIDER=multi

# Verified Primary Lossless Endpoints
